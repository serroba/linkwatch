#!/usr/bin/env bash
# Run LinkWatch headless commands through the app bundle. Launching via LaunchServices
# makes LinkWatch, not the terminal, the process responsible for Location access, so
# macOS reveals the Wi-Fi name; output streams back through private named pipes.
set -euo pipefail
# Prefer LINKWATCH_APP, then this checkout's build, then an installed copy.
app=""
for candidate in "${LINKWATCH_APP:-}" "$(cd "$(dirname "$0")/.." && pwd)/dist/LinkWatch.app" \
  /Applications/LinkWatch.app "$HOME/Applications/LinkWatch.app"; do
  if [[ -n "$candidate" && -x "$candidate/Contents/MacOS/LinkWatch" ]]; then
    app="$candidate"
    break
  fi
done
if [[ -z "$app" ]]; then
  echo "LinkWatch: no LinkWatch.app found; install it or run scripts/build_app.sh" >&2
  exit 69
fi
run_dir="$(mktemp -d)"
cleanup() {
  if [[ -f "$run_dir/pid" && ! -f "$run_dir/status" ]]; then
    kill "$(cat "$run_dir/pid")" 2>/dev/null || true
  fi
  rm -rf "$run_dir"
}
trap cleanup EXIT
trap 'exit 130' INT TERM
mkfifo "$run_dir/out" "$run_dir/err"
cat "$run_dir/out" &
out_reader=$!
cat "$run_dir/err" >&2 &
err_reader=$!
if ! open -n -g --stdout "$run_dir/out" --stderr "$run_dir/err" \
  --env "LINKWATCH_RUN_DIR=$run_dir" "$app" --args "${@:-help}"; then
  kill "$out_reader" "$err_reader" 2>/dev/null || true
  echo "LinkWatch: could not launch $app" >&2
  exit 69
fi
wait "$out_reader" "$err_reader"
exit "$(cat "$run_dir/status" 2>/dev/null || echo 70)"
